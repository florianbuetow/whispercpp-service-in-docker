# Host paths are relative to this project's compose.yaml.
HOST_DATA_DIR=./data
HOST_MODELS_DIR=./models
HOST_PORT=8000
HOST_BIND_ADDRESS=127.0.0.1

# CPU allowance and whisper.cpp worker threads.
CPU_CORES=4
WHISPER_THREADS=4

# Container settings.
DEFAULT_MODEL=medium.en
BIND_HOST=0.0.0.0
DATA_DIR=/data
MODEL_DIR=/models
MAX_UPLOAD_BYTES=1073741824
